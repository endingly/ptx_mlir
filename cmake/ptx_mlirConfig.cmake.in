@PACKAGE_INIT@

set(@PACKAGE_NAME@_VERSION "@PACKAGE_VERSION@")
set(@PACKAGE_NAME@_SUPPORTED_COMPONENTS "@PACKAGE_COMPONENTS@")
set(_@PACKAGE_NAME@_target_components @PACKAGE_TARGET_COMPONENTS@)

set(_@PACKAGE_NAME@_unsupported_components "")
set(_@PACKAGE_NAME@_needs_targets FALSE)
if(NOT @PACKAGE_NAME@_FIND_COMPONENTS)
    set(_@PACKAGE_NAME@_needs_targets TRUE)
endif()
foreach(_@PACKAGE_NAME@_component IN LISTS @PACKAGE_NAME@_FIND_COMPONENTS)
    if(NOT _@PACKAGE_NAME@_component IN_LIST @PACKAGE_NAME@_SUPPORTED_COMPONENTS)
        set(@PACKAGE_NAME@_${_@PACKAGE_NAME@_component}_FOUND FALSE)
        list(APPEND _@PACKAGE_NAME@_unsupported_components
             "${_@PACKAGE_NAME@_component}")
        continue()
    endif()

    set(@PACKAGE_NAME@_${_@PACKAGE_NAME@_component}_FOUND TRUE)
    if(_@PACKAGE_NAME@_component IN_LIST _@PACKAGE_NAME@_target_components)
        set(_@PACKAGE_NAME@_needs_targets TRUE)
    endif()
endforeach()

if(_@PACKAGE_NAME@_unsupported_components)
    string(CONCAT @PACKAGE_NAME@_NOT_FOUND_MESSAGE
        "Unsupported @PACKAGE_NAME@ component(s): "
        "${_@PACKAGE_NAME@_unsupported_components}. Supported components: "
        "${@PACKAGE_NAME@_SUPPORTED_COMPONENTS}")
endif()

check_required_components(@PACKAGE_NAME@)
if(DEFINED @PACKAGE_NAME@_FOUND AND NOT @PACKAGE_NAME@_FOUND)
    return()
endif()

if(_@PACKAGE_NAME@_needs_targets)
    include(CMakeFindDependencyMacro)
@PACKAGE_DEPENDENCY_CALLS@
    include("${CMAKE_CURRENT_LIST_DIR}/@PACKAGE_NAME@Targets.cmake")
endif()

unset(_@PACKAGE_NAME@_component)
unset(_@PACKAGE_NAME@_unsupported_components)
unset(_@PACKAGE_NAME@_target_components)
unset(_@PACKAGE_NAME@_needs_targets)
